# rln-zone-poc: copy to .env, then `set -a; source .env; set +a` (clap reads env vars, not the file)

# Logos Blockchain node HTTP API (local, no auth) that funds and submits the batches.
NODE_URL=http://127.0.0.1:8080

# Node wallet key that pays the Mantle Transaction fees: the `PoWClaim` key of the node's
# keystore, where the mined rewards are (`yq .public_keys.PoWClaim ~/keystore.yaml`).
FUNDING_PK=

# Hard cap per publish, in atomic units.
MAX_TX_FEE=1000000

# Zone channel: id = sha256(CHANNEL_NAME), or CHANNEL_ID (64 hex) to set it directly.
CHANNEL_NAME=rln-membership-zone:testnet:v0.3.0

# Registration program on the testnet LEZ (deployed in block 49431): its account id, the
# registry it serves (`tree_id`, first field of every event). FIRST_LEZ_BLOCK_ID only matters
# for LEZ_SOURCE=indexer; the ticking stand-in starts at the block of its first start.
PROGRAM_ACCOUNT_ID=f04803944507677bb79b27b61cd0ad6eea81928f281570347e2df6249495106a
TREE_ID=47b2de4f08080e74e2d4beffe8e5e87e709dd598619c9b322b64f2756979b4cf
FIRST_LEZ_BLOCK_ID=49431

# LEZ source: `indexer` (a LEZ Indexer's JSON-RPC, see README) or `ticking` (stand-in clock).
LEZ_SOURCE=ticking
LEZ_INDEXER_URL=http://127.0.0.1:8779
LEZ_SEQUENCER_URL=https://testnet.lez.logos.co
POLL_SEC=10
HEARTBEAT_SEC=600

# Where the accredited key, the Zone SDK checkpoint and the batch history live.
DATA_DIR=poc/data
HTTP_ADDR=127.0.0.1:3000
