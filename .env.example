# zone-sequencer: copy to .env, then `set -a; source .env; set +a` (clap reads env vars, not the file)

# Logos Blockchain node HTTP API (local, no auth) that funds and submits the batches.
NODE_URL=http://127.0.0.1:8080

# Node wallet key that pays the Mantle Transaction fees: the `PoWClaim` key of the node's
# keystore, where the mined rewards are (`yq .public_keys.PoWClaim ~/keystore.yaml`).
FUNDING_PK=

# Hard cap per publish, in atomic units.
MAX_TX_FEE=1000000
# Reserve over the mandatory fee, in percent (Zone SDK default 12). Block builders take the
# mempool in FIFO order, a tip buys no priority on the testnet.
PRIORITY_FEE_PERCENT=12

# Zone channel: id = sha256(CHANNEL_NAME), or CHANNEL_ID (64 hex) to set it directly.
CHANNEL_NAME=rln-membership-zone:testnet:v0.3.0

# Registration program on the testnet LEZ (deployed in block 49431): its account id, the
# registry it serves (`tree_id`, first field of every event), the block it was deployed in.
PROGRAM_ACCOUNT_ID=f04803944507677bb79b27b61cd0ad6eea81928f281570347e2df6249495106a
TREE_ID=47b2de4f08080e74e2d4beffe8e5e87e709dd598619c9b322b64f2756979b4cf
FIRST_LEZ_BLOCK_ID=49431

# LEZ Sequencer JSON-RPC the blocks come from: the public testnet one, or http://127.0.0.1:3040
# for a LEZ sequencer run next to the PoC (lez-sequencer/, see docs/setup-rln-membership-zone.md).
LEZ_SEQUENCER_URL=https://testnet.lez.logos.co
# A Register transaction carries the client's timestamp, not the expiry the program computes.
# Set the membership lifetime once the program's rule is known; unset = never expire in the PoC.
#ACTIVE_DURATION_MS=
POLL_SEC=10
HEARTBEAT_SEC=600
# LIB slots an unmined batch waits before the Zone SDK re-funds it under a new transaction
# (0 = never). Off: the mempool is FIFO, a re-funded transaction goes to the back of the queue.
STALE_REFUND_SLOTS=0

# Where the accredited key, the Zone SDK checkpoint and the batch history live.
DATA_DIR=zone-sequencer/data
HTTP_ADDR=127.0.0.1:3000
