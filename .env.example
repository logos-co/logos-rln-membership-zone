# Zone node configuration (the sequencer, and an indexer beside it). Copy to .env, then
# `set -a; . ./.env; set +a` before `cargo run` (clap reads process env vars, not the file).
# An indexer overrides on its command line: MODE=indexer DATA_DIR=data-indexer HTTP_ADDR=...


# ---- Logos Blockchain node (Bedrock) ------------------------------------------------------

# HTTP API of the local node (no auth). It funds and submits the batches and feeds the Zone SDK.
NODE_URL=http://127.0.0.1:8080

# Node wallet key that pays the batches: the PoWClaim key of the node keystore, where the
# mined rewards are (`yq .public_keys.PoWClaim ~/keystore.yaml`).
FUNDING_PK=

# Fee cap per publish, atomic units (1 LGO = 1e9). A batch costs a few thousand.
MAX_TX_FEE=1000000

# Reserve over the mandatory fee, percent; the excess is a tip. Block builders take the
# mempool in order, so a tip buys nothing on the testnet (Zone SDK default 12).
PRIORITY_FEE_PERCENT=12

# LIB slots an unmined batch waits before the Zone SDK re-funds it under a new transaction;
# 0 = never. A re-funded transaction goes to the back of the mempool queue.
STALE_REFUND_SLOTS=0


# ---- Zone channel ---------------------------------------------------------------------------

# Channel id = sha256(CHANNEL_NAME). The key in DATA_DIR/key.hex signs the first inscription and
# becomes the channel's accredited key. CHANNEL_ID (64 hex) overrides the name.
CHANNEL_NAME=rln-membership-zone:testnet:v0.3.2-2


# ---- Registration program on LEZ ------------------------------------------------------------

# The LEZ channel on Bedrock: the LEZ blocks come from its inscriptions through the Zone SDK,
# adopted ones for the sequencer, finalized ones for the indexer's judgments.
LEZ_CHANNEL_ID=0101010101010101010101010101010101010101010101010101010101010101

# LEZ Sequencer JSON-RPC that fills the finalized LEZ history fast (pinned by hash to the blocks
# Bedrock finalized): the public testnet one, or http://127.0.0.1:3040 for a LEZ sequencer run
# next to this one (lez-sequencer/).
LEZ_SEQUENCER_URL=https://testnet.lez.logos.co

# The program's account id (hex), the registry it serves (tree_id, first field of every event)
# and the LEZ block it was deployed in (nothing before it is read).
PROGRAM_ACCOUNT_ID=f04803944507677bb79b27b61cd0ad6eea81928f281570347e2df6249495106a
TREE_ID=47b2de4f08080e74e2d4beffe8e5e87e709dd598619c9b322b64f2756979b4cf
FIRST_LEZ_BLOCK_ID=49431


# ---- Batching ----------------------------------------------------------------------------

# Seconds between publish checks (the sequencer) or judgments (the indexer); a change from an
# adopted LEZ block makes a batch at the next check.
POLL_SEC=10

# Publish an empty batch after this long without one (liveness, and a fresh to_lez_block_id).
HEARTBEAT_SEC=3600


# ---- Service -----------------------------------------------------------------------------

# sequencer (publishes the batches) or indexer (follows both channels with a throwaway key that
# is not accredited and judges every batch against the tree of the LEZ blocks finalized on
# Bedrock; no funds, no key file). An indexer beside the sequencer needs its own DATA_DIR and
# HTTP_ADDR; FUNDING_PK is ignored.
MODE=sequencer

# key.hex (the sequencer's channel key) and the tree store: the tree of the finalized LEZ
# blocks, the adopted ones over it, the reader's state, the Zone channel state, both Zone SDK
# checkpoints. Never delete the store while the channel is in use; start a new CHANNEL_NAME
# instead.
DATA_DIR=data

# HTTP registry API bind address.
HTTP_ADDR=127.0.0.1:3000
