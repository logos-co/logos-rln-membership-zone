# demo: copy to .env, then `set -a; source .env; set +a` (or pass as flags)

# Logos Blockchain node HTTP API that funds and submits the inscriptions
# (local single-node chain started by devnet/run.sh).
NODE_URL=http://127.0.0.1:8080
NODE_AUTH_USER=
NODE_AUTH_PASSWORD=

# Node wallet key that pays the Mantle Transaction fees (a dev key of the standalone config, funded by
# `devnet/run.sh fund`).
FUNDING_PK=9750fa86471fddc69749aa9f8568ef6635e64d9f9aa815e8cb932cea183c8e18

# Hard cap per publish, in atomic units.
MAX_TX_FEE=1000000

