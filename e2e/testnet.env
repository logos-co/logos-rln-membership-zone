# e2e/testnet.env: the RLN Membership Zone on the Logos testnet, read by e2e/*.sh.
# State and secrets live under E2E_STATE (default e2e/state/testnet, gitignored): the LEZ
# payer wallet and the pending deposit.

NETWORK=testnet

# The LEZ sequencer the program lives on, and its Bedrock channel (getChannelId).
LEZ_SEQUENCER_URL=https://testnet.lez.logos.co
LEZ_CHANNEL_ID=0101010101010101010101010101010101010101010101010101010101010101

# The registration program and the registry the Zone follows (same as zone-sequencer/.env).
PROGRAM_ACCOUNT_ID=f04803944507677bb79b27b61cd0ad6eea81928f281570347e2df6249495106a
TREE_ID=47b2de4f08080e74e2d4beffe8e5e87e709dd598619c9b322b64f2756979b4cf

# The Bedrock node that holds the L1 funds (its wallet pays the deposit) and the Zone sequencer.
BEDROCK_HTTP=127.0.0.1:8080
ZONE_HTTP=127.0.0.1:3000

# Funding. A deposit spends one note of exactly DEPOSIT_AMOUNT (atomic, 1 LGO = 1e9); a
# registration needs the payer to hold about 2.5e8 (price plus the fee reserve, mostly
# refunded). Mined PoW rewards are 2.5e7 per note, so the node first makes a note of this size.
DEPOSIT_AMOUNT=300000000
PAYER_MIN=250000000

# A checkout of logos-lez-rln (branch feat/rln-zone-events) with mint_payer, register_member
# and account_balance built (debug or release).
LEZ_RLN_CHECKOUT=$HOME/logos-lez-rln
