# e2e/local/local.env: the whole stack on one machine, read by the e2e scripts. Built and run by
# e2e/local/stack.sh: a Bedrock dev node (docker, from the LEZ checkout's bedrock/), a LEZ
# sequencer that inscribes into it, the lez-rln registration program deployed on it, the
# Zone node. State lives under E2E_STATE (default e2e/local/state, gitignored): the payer
# wallet (funded at the LEZ genesis, no deposit needed), state.json (payer, program, tree,
# first block), zone.env (the Zone node's configuration for this stack).

NETWORK=local

# The LEZ sequencer the program lives on, and its Bedrock channel (the LEZ debug config).
LEZ_SEQUENCER_URL=http://127.0.0.1:3040
LEZ_CHANNEL_ID=0101010101010101010101010101010101010101010101010101010101010101

# The registration program and the registry, as `stack.sh program` deployed them; the
# step writes them to state.json, which this file reads back (`stack.sh program`).
E2E_LOCAL_STATE="${E2E_STATE:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/state}/state.json"
PROGRAM_ACCOUNT_ID="${PROGRAM_ACCOUNT_ID:-$(jq -r '.program_account_id // empty' "$E2E_LOCAL_STATE" 2>/dev/null || true)}"
TREE_ID="${TREE_ID:-$(jq -r '.tree_id // empty' "$E2E_LOCAL_STATE" 2>/dev/null || true)}"

# The Bedrock dev node (the LEZ checkout's bedrock/docker-compose.yml) and the Zone node.
BEDROCK_HTTP=127.0.0.1:18080
ZONE_HTTP=127.0.0.1:3000

# The payer holds its genesis balance; a registration costs ~1e6 plus the fee reserve.
LEZ_RLN_GAS_LIMIT=2000000
PAYER_MIN=40000000

# The checkouts: logos-lez-rln (branch feat/rln-zone-events) with mint_payer, register_member,
# slash_member and run_setup built and the guest binary staged (see README.md here), and
# logos-execution-zone at the tag the Zone pins (v0.3.2), whose bedrock/ runs the dev node
# and whose tools/run_sequencer.sh runs the LEZ sequencer. run.sh clones both into this folder.
LEZ_RLN_CHECKOUT="${LEZ_RLN_CHECKOUT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lez-rln}"
LEZ_CHECKOUT="${LEZ_CHECKOUT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lez}"
