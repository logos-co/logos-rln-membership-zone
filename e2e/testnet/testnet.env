# e2e/testnet/testnet.env: the RLN Membership Zone on the Logos testnet, read by e2e/*.sh.
# State and secrets live under E2E_STATE (default e2e/testnet/state, gitignored): the LEZ
# payer wallet and the pending deposit.

NETWORK=testnet

# The LEZ sequencer the program lives on, and its Bedrock channel (getChannelId).
LEZ_SEQUENCER_URL=https://testnet.lez.logos.co
LEZ_CHANNEL_ID=0101010101010101010101010101010101010101010101010101010101010101

# The registration program and the registry the Zone follows (same as the root .env).
PROGRAM_ACCOUNT_ID=f04803944507677bb79b27b61cd0ad6eea81928f281570347e2df6249495106a
TREE_ID=47b2de4f08080e74e2d4beffe8e5e87e709dd598619c9b322b64f2756979b4cf

# The Bedrock node that holds the L1 funds (its wallet pays the deposit) and the Zone node the
# scenarios read (the sequencer; an indexer would do for proof.sh).
BEDROCK_HTTP=127.0.0.1:8080
ZONE_HTTP=127.0.0.1:3000

# Funding. A deposit spends one note of exactly DEPOSIT_AMOUNT (atomic, 1 LGO = 1e9). Mined PoW
# rewards come as small notes (about 2e6 each lately), so the node first makes a note of this
# size, merging at most 32 notes per transaction.
# A membership transaction must find the payer holding the price (rate_limit x price_per_unit,
# 1e6 for a registration) plus the fee reserve LEE admits it against: gas_limit x base fee x 2,
# refunded down to the fee really paid (~1.4e6). The lez-rln client declares the 10e6 gas
# ceiling unless LEZ_RLN_GAS_LIMIT says less; 2e6 is its wallet's own default, 3x a slash
# (~650k gas) and 40x a registration (~53k), and makes the reserve ~36e6.
DEPOSIT_AMOUNT=300000000
LEZ_RLN_GAS_LIMIT=2000000
PAYER_MIN=40000000

# A checkout of logos-lez-rln (branch feat/rln-zone-events) with mint_payer, register_member
# and slash_member built (debug or release).
LEZ_RLN_CHECKOUT=$HOME/logos-lez-rln
