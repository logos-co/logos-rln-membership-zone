# Generated by Cargo will have compiled files and executables
/target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# Editors and OS
.vscode
.idea
.DS_Store

# Coding-agent personal files and tool outputs
.claude/
CLAUDE.md
CLAUDE.local.md
.gemini/
GEMINI.md
.codex/
.cursor/
.windsurf/
.aider*
graphify-out/

# Misc
*.log
logs/
tmp/

# Secrets and node configuration: the Bedrock node keys, the accredited zone key, the env
.env
*.key
checkpoint*.json

# Zone sequencer: accredited key and the tree store (tree, reader state, batches, SDK checkpoint)
/data/
# Zone indexer run beside it (MODE=indexer DATA_DIR=data-indexer)
/data-indexer/
# Own LEZ sequencer: its home (RocksDB, keys)
/lez-sequencer/home/
# e2e: per-network state (the LEZ payer wallet, pending deposit)
/e2e/state/
