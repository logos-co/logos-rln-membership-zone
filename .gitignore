# Generated by Cargo will have compiled files and executables
/target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# Editors and OS
.vscode
.idea
.DS_Store

# Coding-agent personal files and tool outputs
.claude/
CLAUDE.md
CLAUDE.local.md
.gemini/
GEMINI.md
.codex/
.cursor/
.windsurf/
.aider*
graphify-out/

# Misc
*.log
logs/
tmp/

# Secrets and node configuration: the Bedrock node keys, the accredited zone key, the env
.env
*.key
checkpoint*.json

# Zone sequencer: accredited key and the tree store (tree, reader state, batches, SDK checkpoint)
/data/
# Zone indexer run beside it (MODE=indexer DATA_DIR=data-indexer)
/data-indexer/
# The local stack's Zone node and indexer run by hand (e2e/local/stack.sh zone-env)
/data-local/
/data-local-indexer/
# Own LEZ sequencer: its home (RocksDB, keys)
/lez-sequencer/home/
# e2e: per-target state (the LEZ payer wallet, pending deposit, the local stack's homes)
/e2e/testnet/state/
/e2e/local/state/
# e2e/local/run.sh: the clones it builds the local stack from, and every component's log
/e2e/local/lez/
/e2e/local/lez-rln/
/e2e/local/logs/
